# ── 서울 아파트 시세 지도 (seoul-apt) ──────────────────────────────────
# 공공데이터포털 실거래가 인증키 (매매/전월세 공통, Decoding 키)
# https://www.data.go.kr/data/15126469/openapi.do  및  /15126474
DATA_GO_KR_KEY=your_data_go_kr_key

# 한국부동산원 R-ONE OpenAPI 인증키 (시세/가격지수)
# https://www.reb.or.kr/r-one/openapi/openApiIntroPage.do
REB_API_KEY=your_reb_key

# 카카오 REST API 키 (주소→좌표 지오코딩)
# https://developers.kakao.com  (앱 → 앱 키 → REST API 키)
KAKAO_REST_KEY=your_kakao_rest_key

# 카카오 JavaScript 키 (지도 표시, export 시 docs/js/config.js 로 주입)
KAKAO_JS_KEY=your_kakao_js_key

# 텔레그램 알림/다이제스트 (@BotFather 발급 토큰, 발송 대상 chat_id)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Gemini 주간 AI 추천 (선택, aistudio.google.com 무료 티어)
GEMINI_API_KEY=your_gemini_key
